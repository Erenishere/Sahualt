{
  "components": {
    "schemas": {
      "ErrorDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetails",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "VoiceResponse": {
        "additionalProperties": false,
        "properties": {
          "audio_sha256": {
            "title": "Audio Sha256",
            "type": "string"
          },
          "contract_version": {
            "const": "voice-http-v1",
            "default": "voice-http-v1",
            "title": "Contract Version",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "transcript_checksum": {
            "title": "Transcript Checksum",
            "type": "string"
          }
        },
        "required": [
          "language",
          "text",
          "model",
          "revision",
          "audio_sha256",
          "transcript_checksum"
        ],
        "title": "VoiceResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sahulat AI Voice Runtime",
    "version": "voice-http-v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/transcriptions": {
      "post": {
        "operationId": "transcribe_api_v1_transcriptions_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Voice-Language",
            "required": true,
            "schema": {
              "enum": [
                "en",
                "ur"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "audio/wav": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed or unsupported WAV audio"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Audio upload timeout or disconnect"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Audio byte limit exceeded"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported request encoding or media type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported language, empty transcript or query fields"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Transcription failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Voice model unavailable or busy"
          }
        },
        "summary": "Transcribe"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Voice model unavailable or busy"
          }
        },
        "summary": "Ready"
      }
    }
  }
}

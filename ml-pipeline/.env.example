# Copy this file to .env and replace placeholder secrets locally.
# Never commit .env.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sahulat_ai_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/sahulat_ai_dev

# Initial CPU serving choice; see docs/ADR-ML-001-visual-encoder-selection.md.
VISUAL_MODEL=openclip
VISUAL_DEVICE=auto
VISUAL_BATCH_SIZE=16
VISUAL_NUM_WORKERS=0
VISUAL_PRODUCT_TOP_K=5
VISUAL_IMAGE_TOP_K=25
VISUAL_CACHE_DIR=.cache/models

# Internal visual HTTP adapter: export process variables; .env is not auto-loaded.
AI_VISUAL_INDEX_PATH=artifacts/catalogue-openclip.npz
AI_VISUAL_INDEX_SHA256=your_approved_index_sha256_here
AI_VISUAL_SOURCE_SYSTEM=khaadi-v1
AI_MAX_CONCURRENT_REQUESTS=1
AI_BODY_TIMEOUT_SECONDS=15
HF_HUB_OFFLINE=1

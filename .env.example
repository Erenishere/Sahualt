# Monorepo local development (copy to .env at repo root)

# PostgreSQL (backend + ML migrations)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Compose admin credential for local database initialization only; never use it as an API login.
POSTGRES_ADMIN_PASSWORD=
DATABASE_NAME=sahulat_ai_dev

# Redis
REDIS_URL=redis://localhost:6379

# Backend
BACKEND_URL=http://localhost:5272
NEXT_PUBLIC_BACKEND_URL=http://localhost:5272
FRONTEND_URL=http://localhost:3000
# Set these in the backend process environment; the .NET host does not load this file itself.
ConnectionStrings__AssistantReader=
ConnectionStrings__IdentityReader=
# Optional dedicated catalog writer; without it catalog POST endpoints return 503.
ConnectionStrings__CatalogWriter=
# Local development registration writer; no registration endpoint is enabled outside Development.
ConnectionStrings__RegistrationWriter=
# Customer account, offers, checkout, orders, and vendor fulfillment runtime.
ConnectionStrings__CommerceWriter=
# Dedicated platform administration runtime.
ConnectionStrings__AdminWriter=
Frontend__Origin=http://localhost:3000
DataProtection__KeysPath=
# Use Local only in development with an absolute private filesystem path.
Media__Provider=
Media__Local__Root=
# Private S3-compatible bucket for vendor images; use deployment secrets for keys.
Media__S3__Endpoint=
Media__S3__Region=
Media__S3__Bucket=
Media__S3__AccessKey=
Media__S3__SecretKey=

# ML HTTP services (backend calls these; frontend does not)
ML_VISUAL_API_URL=http://localhost:8001
ML_TEXT_API_URL=http://localhost:8002
ML_VOICE_API_URL=http://localhost:8003
